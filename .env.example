# Movra — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com as chaves do seu projeto Supabase.
# Supabase Dashboard → Project Settings → API

# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Chave anônima (pública — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role (SECRETA — somente servidor, ignora RLS). NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (lembretes de treino) — gere com `node scripts/gen-vapid.mjs`.
# A pública vai aqui; a PRIVADA vira segredo da Edge Function (nunca no cliente).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Publicação nas lojas (Play Store) ---

# Identidade legal do controlador (LGPD art. 9º) — aparece na Política de
# Privacidade e nos Termos. Mantida em env para NÃO commitar CPF/CNPJ no repo.
NEXT_PUBLIC_LEGAL_CONTROLLER=
NEXT_PUBLIC_LEGAL_DOCUMENT=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# Data da última revisão dos documentos legais (ex.: "29 de julho de 2026").
NEXT_PUBLIC_LEGAL_UPDATED=

# Digital Asset Links do app Android (TWA) — preencha DEPOIS de gerar o pacote
# com o Bubblewrap. Servem em /.well-known/assetlinks.json e removem a barra de
# URL. O fingerprint aceita vários valores separados por vírgula.
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINT=
